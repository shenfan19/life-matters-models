metadata:
  name: dracula
  lm_format_version: "1.0"
  updated: 2026-04-23
  authors:
  - name: Fan Shen
    email: shenfan@mail.sysu.edu.cn
  description:
    problem: >
      德古拉的生存动力学由血液储备与饥渴度之间的周期性平衡决定：基础代谢持续消耗血储（−0.1/step）并积累饥渴（+0.5/step），
      日照暴露（> 0.5 强度）加速血液损耗（−5×exposure/step），仅有夜间狩猎可补充；
      核心张力在于日间活动风险与夜间狩猎频率之间的权衡——血液耗尽或日照过强均为致命。
    result: >
      仿真预期显示百年生存期（1462–1562）内血液储备与饥渴度随日/季节循环的波动，以及日照阈值下的临界状态——展示性虚构场景，仿真参数为叙事设计值。
    limitations: 完全虚构设定，所有参数为叙事设计，无学术依据；仅作为 LM 框架极端泛化能力的演示。
  ratings:
    topic_importance: 2 - 虚构生物设定，话题吸引力和科学价值均有限
    framework_demand: 1 - 虚构展示场景，不被其他模型引用
    evidence_quality: 2 - 神话设定，物理参数完全为创作设计
    innovation: 3 - 将虚构生物动力学建模，展示框架的极端泛化能力
    social_value: 3 - 娱乐价值高，展示 LM 框架的叙事灵活性，学术价值有限
  tags: [mythical, physiological, dracula]
  step_size:
    value: 1
    unit: hour

variables:
  blood_reserve: {description: "血液储备", value: 80.0, unit: "%", type: state, bounds: [0, 100]}
  thirst_level: {description: "饥渴度", value: 10.0, unit: "分", type: state, bounds: [0, 100]}
  sun_exposure: {description: "日照暴露", value: 0.0, unit: "强度", type: input, bounds: [0, 1]}
  hunt_intensity: {description: "狩猎强度", value: 0.0, unit: "次", type: input}

formulas:
  metabolism:
    description: "基础代谢：随时间增加饥渴，减少血液储备"
    condition: true
    dynamics:
      thirst_level: "thirst_level + 0.5 * step"
      blood_reserve: "blood_reserve - 0.1 * step"
    priority: 5

  sun_damage:
    description: "紫外线伤害：日光暴露会导致血液储备迅速下降"
    condition: sun_exposure > 0.5
    dynamics:
      blood_reserve: "blood_reserve - sun_exposure * 5 * step"
    priority: 10

  feeding:
    description: "进食：狩猎成功可显著恢复血液并降低饥渴"
    condition: hunt_intensity > 0
    dynamics:
      blood_reserve: "blood_reserve + hunt_intensity * 20"
      thirst_level: "thirst_level - hunt_intensity * 30"
    priority: 7

schedules:
  sun_exposure:
    interpolation: linear
    points:
    - {time: 0, value: 0.0}          # 00:00 Night
    - {time: 21600, value: 0.0}      # 06:00 Dawn begins
    - {time: 28800, value: 0.8}      # 08:00 Full Sun
    - {time: 43200, value: 1.0}      # 12:00 Noon
    - {time: 64800, value: 0.5}      # 18:00 Sunset
    - {time: 72000, value: 0.0}      # 20:00 Night
    - {time: 86400, value: 0.0}      # 24:00 Next day

simulation:
  start_date: "1462-06-01"
  end_date: "1562-05-31"
  plans:
    - id: default
      label: Default
      schedules:
        - variable: hunt_intensity
          time: "22:00"
          value: 1.0
          days: [Mon, Wed, Fri]
          label: 夜间狩猎（每周三次）
  output_variables: [blood_reserve, thirst_level, sun_exposure, hunt_intensity]

optimizer:
  method: nsga2
  objectives:
    - variable: blood_reserve
      direction: maximize
      metric: final
      description: 最大化血液储备（生存资源）
    - variable: thirst_level
      direction: minimize
      metric: final
      description: 最小化饥渴程度（生活质量）
  constraints:
    - variable: blood_reserve
      condition: ">= 10"
      type: hard
      description: 血液储备不得低于 10%（死亡线）
  schedules:
    - variable: hunt_intensity
      time: "22:00"
      label: 夜间狩猎强度（0=不猎，3=全力）
      optimize:
        value: [0.0, 3.0]
  algorithm:
    population_size: 50
    n_generations: 80
    seed: 19
