# ignore output folder and the results of the tests
output/
_saved_/

# per-model debug history (superseded YAML versions), author's own record only (ADR 0141)
**/history/

# ad-hoc draft/probe directories created next to a model file (lm-modeling-diagnosis,
# lm-modeling-advisor agents/), any depth, any suffix after temp_
**/temp_*/

# per-model literature cache: reference/ 下的 .bib 与 cite_review.md 随仓库发布，
# 但 PDF 原文（多为付费墙文献）不发布，仅本地保留供人工/AI 核对引用位置用
**/reference/*.pdf
