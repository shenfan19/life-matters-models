# ignore output folder and the results of the tests
output/
_saved_/

# per-model debug history (superseded YAML versions), author's own record only (ADR 0141)
**/history/

# ad-hoc draft/probe directories created next to a model file (lm-modeling-diagnosis,
# lm-modeling-advisor agents/), any depth, any suffix after temp_
**/temp_*/

# per-model literature cache: the .bib and cite_review.md files under reference/ are published
# with the repository, but the original PDFs (mostly paywalled literature) are not published,
# kept locally only for human/AI use in checking citation locations
**/reference/*.pdf
